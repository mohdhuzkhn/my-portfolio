# fumadocs-core@16's peer range wants next@16.x, but Next.js 15 is the
# mandated version for this project. Both fumadocs and Next 15 are
# required by the approved tech stack, and their peer ranges genuinely
# conflict — this isn't a version we chose carelessly. legacy-peer-deps
# tells npm to install anyway (matching npm 6 behavior), same as running
# `npm install --legacy-peer-deps` manually every time.
legacy-peer-deps=true
